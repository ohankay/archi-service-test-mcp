{
  "inputs": [
    { "type": "promptString", "id": "stm-pw-ntlm", "description": "Servis kullanicisi (NTLM) sifresi", "password": true },
    { "type": "promptString", "id": "stm-token-api", "description": "REST API bearer token", "password": true },
    { "type": "promptString", "id": "stm-secret-test-sifre", "description": "Test kullanicisi login sifresi (senaryolarda {{secret.STM_SECRET_TEST_SIFRE}})", "password": true }
  ],
  "servers": {
    "archi-service-test": {
      "type": "stdio",
      "command": "${userHome}\\.service-test-mcp\\Scripts\\service-test-mcp.exe",
      "env": {
        "STM_CONFIG": "${userHome}\\.service-test-mcp\\services.yaml",
        "STM_PW_NTLM": "${input:stm-pw-ntlm}",
        "STM_TOKEN_API": "${input:stm-token-api}",
        "STM_SECRET_TEST_SIFRE": "${input:stm-secret-test-sifre}"
      }
    }
  }
}
